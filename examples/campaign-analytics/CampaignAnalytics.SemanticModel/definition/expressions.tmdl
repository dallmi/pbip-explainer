/// Maps division keys to the reporting region.
expression 'Region Map' =
		let
			Source = Table.FromRows({{"GWM", "Global"}, {"IB", "Americas"}, {"PCB", "Switzerland"}}, {"Division Key", "Region"})
		in
			Source
